# ============================================================
# 小说转漫剧 Agent  ——  环境变量模板
# 使用方式: 复制为 .env 并填入真实 Key
#   cp .env.example .env
# ============================================================

# --- LLM（大语言模型）-------------------------------------------------
# DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 兼容 OpenAI 接口的备用地址（默认 https://api.deepseek.com）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（deepseek-chat / deepseek-reasoner）
LLM_MODEL=deepseek-chat

# 最大输出 Token 数
LLM_MAX_TOKENS=8192

# 生成温度（0-2，越高越随机）
LLM_TEMPERATURE=0.7

# --- 生图 API --------------------------------------------------------
# 生图后端类型: doubao | openai | stable-diffusion | comfyui
IMAGE_API_TYPE=doubao

# 豆包 Ark API Key（https://console.volcengine.com/ark/region:ark+cn-beijing/apikey）
IMAGE_API_KEY=ark-your-ark-api-key-here

# 豆包 Ark API 地址
IMAGE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 生图模型（doubao-seedream-5-0-260128 / doubao-seedream-4-0-250828）
IMAGE_MODEL=doubao-seedream-5-0-260128

# --- TTS（文本转语音）-------------------------------------------------
# TTS 类型: edge-tts（免费，推荐）| openai | volcengine
TTS_API_TYPE=edge-tts

# TTS API Key（edge-tts 免费无需 Key）
TTS_API_KEY=

# TTS API 地址（edge-tts 无需）
TTS_API_BASE_URL=

# 音色: zh-CN-XiaoxiaoNeural(女) / zh-CN-YunxiNeural(男) / zh-CN-YunyangNeural(男配)
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语速倍率
TTS_SPEED=1.0

# --- 输出参数 --------------------------------------------------------
# 视频分辨率（宽）
OUTPUT_WIDTH=1920

# 视频分辨率（高）
OUTPUT_HEIGHT=1080

# 帧率
OUTPUT_FPS=24

# --- 视频生成（Seedance 图生视频）--------------------------------------
# 视频生成后端: doubao (Seedance)
VIDEO_API_TYPE=doubao

# Seedance 模型: doubao-seedance-2-0-260128 / doubao-seedance-2-0-fast-260128
VIDEO_MODEL=doubao-seedance-2-0-260128

# 轮询间隔（秒）
VIDEO_POLL_INTERVAL=5.0

# 轮询超时（秒）
VIDEO_POLL_TIMEOUT=600

# ============================================================
# 小说模型项目 .gitignore
# 只保留程序脚本，排除所有生成数据、原始内容和敏感信息
# ============================================================

# --- Python 缓存 ----------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# --- 环境变量（含 API Key 等敏感信息）--------------------------------
.env
.env.local
**/.env

# --- 小说转漫剧输出数据 ---------------------------------------------
小说转漫剧/output/
小说转漫剧/output/**/*

# --- 自动化工具生成数据 ---------------------------------------------
自动化/日志/
自动化/logs/
自动化/debug/
自动化/chrome_profile/
自动化/chrome_profiles/
自动化/__pycache__/

# --- 项目专用发布配置（含平台ID等敏感信息）-----------------------------
自动化/配置/发布配置-*.yaml
自动化/配置/发布配置-*.yml

# --- 小说原始内容（非程序脚本）----------------------------------------
万古神龙：我的血脉全靠吞/**
全球灾变：我的AI能自动升级/**
**/执行/**
**/策划/**
**/记忆/**
**/校对/**
**/章节_备份/**

# --- macOS 系统文件 --------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE 配置 -------------------------------------------------------
.idea/
.vscode/
*.sublime-*
*.swp
*.swo
*~
.project
.classpath
.settings/

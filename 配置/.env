# --- LLM（DeepSeek）-------------------------------------------------
# DeepSeek API Key（从 https://platform.deepseek.com/api_keys 获取）
DEEPSEEK_API_KEY=sk-84b0c3b8a1114b11bf020b646b1627a9

# API 基础地址（DeepSeek 默认地址）
LLM_BASE_URL=https://api.deepseek.com

# 默认模型（可被脚本覆盖）
